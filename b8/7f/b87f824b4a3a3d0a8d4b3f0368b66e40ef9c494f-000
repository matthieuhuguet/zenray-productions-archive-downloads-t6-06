```jsx
(function () {
  const TYPE_DELAY_MS = 50, RETRY_MS = 2000, COOLDOWN_MS = 1000, WAIT_OPT_MS = 1500;
  let lastRun = 0, lastFallbackTs = 0;

  const visible = el => el && el.offsetParent && getComputedStyle(el).visibility !== "hidden";
  const getComposer = () => Array.from(document.querySelectorAll('textarea, [contenteditable="true"]')).find(el => visible(el) && el.closest('form, [data-testid*="composer"]'));
  const getText = el => el.value ?? el.textContent;
  const isSearchActive = () => document.querySelector('button[aria-pressed="true"], [data-is-selected="true"][data-pill="true"]');

  function setText(el, txt) {
    el.focus();
    if (el.value !== undefined) {
      el.value = txt;
      el.dispatchEvent(new InputEvent('input', { bubbles: true }));
    } else {
      document.execCommand('selectAll', false, null);
      document.execCommand('insertText', false, txt);
    }
  }

  function findSearchOption() {
      const menus = Array.from(document.querySelectorAll('[data-radix-portal] [role="listbox"], [role="listbox"], [role="menu"]')).filter(visible);
      if (!menus.length) return null;
      const candidates = menus.flatMap(m => Array.from(m.querySelectorAll('[role="option"], [role="menuitem"], button'))).filter(el => visible(el) && !el.disabled);
      return candidates.find(el => /search/i.test(el.textContent)) || candidates[0] || null;
  }

  function pressEnter(target) {
    const now = Date.now();
    if (now - lastFallbackTs < COOLDOWN_MS || getText(target).trim() !== '/search') return;
    lastFallbackTs = now;
    target.dispatchEvent(new KeyboardEvent('keydown', { key: 'Enter', code: 'Enter', keyCode: 13, bubbles: true }));
  }

  function tryEnableSearch() {
    if (Date.now() - lastRun < COOLDOWN_MS || isSearchActive()) return;
    lastRun = Date.now();
    
    const ed = getComposer();
    if (!ed) return;

    const current = getText(ed).trim();
    if (current && current !== '/search') return;
    if (current !== '/search') setText(ed, '/search');

    setTimeout(() => {
      const t0 = performance.now();
      (function loop() {
        const opt = findSearchOption();
        if (opt) {
          opt.click();
          setTimeout(() => { if (!isSearchActive()) pressEnter(ed); }, 100);
        } else if (performance.now() - t0 < WAIT_OPT_MS) {
          requestAnimationFrame(loop);
        } else {
          pressEnter(ed);
        }
      })();
    }, TYPE_DELAY_MS);
  }

  setInterval(tryEnableSearch, RETRY_MS);
})();
```

