cmake_minimum_required(VERSION 3.16)
project(QtScreenCapture)

# Utiliser C++17
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

# Chemin vers Qt (MSVC)
set(CMAKE_PREFIX_PATH "C:/PATH/Qt/6.8.1/msvc2022_64")

# Ajouter l'option pour MSVC
if(MSVC)
    set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} /Zc:__cplusplus")
endif()

# Trouver les modules Qt nécessaires
find_package(Qt6 REQUIRED COMPONENTS Core Gui Widgets)

# Ajouter les fichiers sources
add_executable(QtScreenCapture main.cpp)

# Lier les bibliothèques Qt nécessaires
target_link_libraries(QtScreenCapture Qt6::Core Qt6::Gui Qt6::Widgets)

# Désactiver la console
set_target_properties(QtScreenCapture PROPERTIES WIN32_EXECUTABLE TRUE)

# Ajouter une commande post-build pour exécuter windeployqt
if(WIN32)
    add_custom_command(TARGET QtScreenCapture POST_BUILD
        COMMAND "${CMAKE_PREFIX_PATH}/bin/windeployqt.exe" "$<TARGET_FILE:QtScreenCapture>"
        COMMENT "Deploying Qt runtime dependencies using windeployqt"
    )
endif()